    },
    {
      "index": 7,
      "tex": "L_{\\mathrm{basic}} = \\max\\left\\{L_{\\mathrm{cp}},\\ \\left\\lceil\\frac{W_M}{K}\\right\\rceil,\\ \\left\\lceil\\frac{W_V}{K}\\right\\rceil,\\ \\max_{v\\in V}d_v\\right\\} \\le M_q(P).",
      "sha256": "ee6dee593b5bb064c137186b7f084deb9e60ff9bc278d351649ae5a0fb005dc8"
    },
    {
      "index": 8,
      "tex": "L(P) \\ge U,",
      "sha256": "d99883f6b6598c1f6a4153b7196444e589f29b242755f508af250de28cad1501"
    },
    {
      "index": 9,
      "tex": "\\frac{U - \\mathrm{OPT}}{\\mathrm{OPT}} \\le \\frac{U - L}{L} = \\frac{U}{L} - 1.",
      "sha256": "d07b0c50515ae15694e57a5a5b025bf2420b01b4db89cfba909be39e0777739d"
    },
    {
      "index": 10,
      "tex": "T_{\\mathrm{solve}} = T_{\\mathrm{parse}} + T_{\\mathrm{construct}} + T_{\\mathrm{check}} + \\sum_{j=1}^{b} T_j + T_{\\mathrm{IO}},",
      "sha256": "78f150dcec8ac1394bf40befcfadc17dccf01a3df1e36a2f49b89992a95cea79"
    },
    {
      "index": 11,
      "tex": "A_s\\ge F_{\\mathrm{prev}(s)}+100,",
      "sha256": "c432ed1f9a8df360f000240e51d9d5107907ffe7bb003ca44b083767c1b0d87f"
    },
    {
      "index": 12,
      "tex": "A_s\\ge F_t+1000,\\quad t\\in\\operatorname{pred}(s),\\ a(t)\\ne a(s).",
      "sha256": "b0ef3be9517982821d6f6484874b542ae32456f43a22f8b7e8406e59e929f029"
    },
    {
      "index": 13,
      "tex": "s_v\\ge r_v,\\qquad [s_v,s_v+d_v)\\cap\\mathcal I_{k,p_v}=\\varnothing.",
