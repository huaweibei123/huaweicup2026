      "tex": "M\\ge a+b+\\max\\left\\{\\left\\lceil\\frac{\\sum_{v\\in S}d_v}{K}\\right\\rceil,A_K(S)\\right\\}.",
      "sha256": "2b11d96e808b4e588ba58de6a450641568481562de0a3cad404f2afe1d09888e"
    },
    {
      "index": 25,
      "tex": "c(a,b)=\\ell(\\tau_q-a)_++r(\\tau_q-b)_+.",
