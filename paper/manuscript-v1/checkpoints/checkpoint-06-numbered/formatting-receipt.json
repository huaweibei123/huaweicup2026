    },
    {
      "index": 15,
      "tex": "\\Delta_e=w_e\\left(\\mathbf1\\{n_{e,l}=0\\}-\\mathbf1\\{n_{e,k}=|e\\cap A|\\}\\right).",
      "sha256": "815ff5085199fd53d6bf04256904ca0f644b530e1346fad98674fd0cab365a53"
    },
    {
      "index": 16,
      "tex": "\\sum_{j=1}^{R}(w_j+1)T_{\\mathrm{cut}}(n_j,m_j).",
      "sha256": "2c5543138524fb5ed109e49441a7d5cd12f86a527e391b6a41680bc2c6e3573d"
    },
    {
      "index": 17,
      "tex": "H(\\pi)=\\max\\left\\{\\max_j\\left(\\sum_{\\ell<j}r_{\\pi_\\ell}+h_{\\pi_j}\\right),\\ \\sum_i r_i+r_{\\mathrm{parent}}\\right\\}.",
      "sha256": "701ea4536ad1d1b94f7eaee62b116982b7ee71552d3ae78e67bd3bd4afc06650"
    },
    {
      "index": 18,
      "tex": "H_{AB}=\\max(h_A,r_A+h_B),\\qquad H_{BA}=\\max(h_B,r_B+h_A).",
      "sha256": "944725d077d434ac5735cdb6fa26b0493444f62de6464c36104027368976821b"
    },
    {
      "index": 19,
      "tex": "s_v\\ge s_u+d_u+\\delta_{uv}.",
      "sha256": "e69b1367d86b91506830e079aaffd833d4f2513621abced304af689245e02dfd"
    },
    {
      "index": 20,
      "tex": "M_{2,\\mathrm{new}}M_{3,\\mathrm{old}}\\ge M_{2,\\mathrm{old}}M_{3,\\mathrm{new}}.",
      "sha256": "a5f0f45feabe40a5be3c3df77016a159cfff43258fd5f114882c8c3db8ab3823"
    },
    {
      "index": 21,
      "tex": "h_v=\\max_{u\\to v}(h_u+d_u),\\qquad t_v=\\max_{v\\to w}(d_w+t_w).",
      "sha256": "3c3fec54213f6fdd12c575b50568eb188c8ea49cd959738f73318bb38300672d"
    },
    {
      "index": 22,
      "tex": "S=\\{v:p_v=p,\\ h_v\\ge a,\\ t_v\\ge b\\}.",
      "sha256": "ec4b2c2e3e2fbe73898bce1ec164f509988872aa857c9820de64da6f1211e331"
    },
    {
      "index": 23,
      "tex": "A_K(S)=\\max_{\\substack{r\\ge1\\\\m=(r-1)K+1\\le n}}\\sum_{j=m-r+1}^{m}d_{(j)}.",
      "sha256": "566d34958149d6f30befb590f753801707c149d4fc4eeb6f743c6fab4316492d"
    },
