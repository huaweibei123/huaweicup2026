        <mxCell id="title" value="问题三｜树状分支排序与完整方案的评价决策" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#17243B;fontSize=29;fontFamily=PingFang SC;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="20" width="1410" height="46" />
        </mxCell>
        <mxCell id="upper-bg" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F2F5F8;strokeColor=#F2F5F8;strokeWidth=1.5;fontColor=#17243B;fontSize=19;fontFamily=PingFang SC;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="82" width="1420" height="310" />
        </mxCell>
        <mxCell id="upper-label" value="一、排序仅作用于满足条件的树状分支" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F2F5F8;strokeColor=#F2F5F8;strokeWidth=1.5;fontColor=#17243B;fontSize=22;fontFamily=PingFang SC;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="66" y="92" width="700" height="42" />
        </mxCell>
        <mxCell id="scope" value="多棵互不交错的归约树，且至少有一处汇合；&lt;br&gt;每个操作有一个已知字节数的输出；&lt;br&gt;非根输出只供唯一父操作使用。" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EDF4FC;strokeColor=#9BACBF;strokeWidth=1.5;fontColor=#17243B;fontSize=19;fontFamily=PingFang SC;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="158" width="388" height="177" />
        </mxCell>
        <mxCell id="order" value="对子树计算 hᵢ − rᵢ&lt;br&gt;按该值递减处理同一父操作的子树&lt;br&gt;同值按操作编号排序，随后执行父操作" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E9F7F4;strokeColor=#9BACBF;strokeWidth=1.5;fontColor=#17243B;fontSize=20;fontFamily=PingFang SC;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="553" y="170" width="390" height="150" />
        </mxCell>
        <mxCell id="guarantee" value="在上述非交错树模型内，&lt;br&gt;使每棵树内部结果的峰值占用最小。&lt;br&gt;&lt;font color='#53657A'&gt;这是排序量的保证；不推出官方完成时间或缓存效果。&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF4DD;strokeColor=#9BACBF;strokeWidth=1.5;fontColor=#17243B;fontSize=20;fontFamily=PingFang SC;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1038" y="158" width="388" height="177" />
        </mxCell>
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#53657A;strokeWidth=2;endArrow=block;endFill=1;dashed=0;" edge="1" source="scope" target="order" parent="1">
          <mxGeometry as="geometry" relative="1" />
