        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#53657A;strokeWidth=2;endArrow=block;endFill=1;dashed=0;" edge="1" source="order" target="guarantee" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="lower-label" value="二、完整候选共用最多三次在线 E0 评价" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#17243B;fontSize=22;fontFamily=PingFang SC;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="56" y="415" width="1350" height="42" />
        </mxCell>
        <mxCell id="prior" value="基础方案先成当前最优；&lt;br&gt;共享输入或注意力候选先行" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EDF4FC;strokeColor=#9BACBF;strokeWidth=1.5;fontColor=#17243B;fontSize=18;fontFamily=PingFang SC;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="495" width="186" height="111" />
