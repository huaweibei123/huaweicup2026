  <diagram id="p3-forest" name="P3 树状排序与候选评价">
    <mxGraphModel dx="1500" dy="1020" grid="0" page="1" pageScale="1" pageWidth="1500" pageHeight="1020" math="0" shadow="0">
      <root>
