        <mxCell id="scope" value="适用：至少两棵互不交错的归约树，且存在汇合；&lt;br&gt;单输出且字节数已知；非根输出仅供唯一父操作。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF3F8;strokeColor=#68879A;strokeWidth=1.6;fontColor=#183246;fontFamily=PingFang SC;fontSize=22;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=9;spacingBottom=9;" vertex="1" parent="1">
