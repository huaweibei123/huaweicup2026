          <mxGeometry x="374" y="273" width="203" height="51" as="geometry" />
        </mxCell>
        <mxCell id="a_sink" value="汇侧：b" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF2F9;strokeColor=#315F84;strokeWidth=1.5;fontColor=#173042;fontFamily=PingFang SC;fontSize=21;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;shadow=0;glass=0;rotatable=0;" vertex="1" parent="1">
          <mxGeometry x="694" y="273" width="166" height="51" as="geometry" />
        </mxCell>
        <mxCell id="a_source" value="源侧：a" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF2F9;strokeColor=#315F84;strokeWidth=1.5;fontColor=#173042;fontFamily=PingFang SC;fontSize=21;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;shadow=0;glass=0;rotatable=0;" vertex="1" parent="1">
          <mxGeometry x="92" y="351" width="166" height="51" as="geometry" />
        </mxCell>
        <mxCell id="a_aux2" value="辅助节点 q_b" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F1EBFA;strokeColor=#795A9D;strokeWidth=1.5;fontColor=#173042;fontFamily=PingFang SC;fontSize=21;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;shadow=0;glass=0;rotatable=0;" vertex="1" parent="1">
          <mxGeometry x="374" y="351" width="203" height="51" as="geometry" />
        </mxCell>
        <mxCell id="a_pins2" value="u、v" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E7F5F2;strokeColor=#268078;strokeWidth=1.5;fontColor=#173042;fontFamily=PingFang SC;fontSize=21;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;shadow=0;glass=0;rotatable=0;" vertex="1" parent="1">
          <mxGeometry x="694" y="351" width="166" height="51" as="geometry" />
        </mxCell>
        <mxCell id="a_note" value="两行的 u、v 是同一组链；分别列出“有链在 a”和“有链在 b”的容量边。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=0;fontColor=#40566A;fontFamily=PingFang SC;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;shadow=0;glass=0;rotatable=0;" vertex="1" parent="1">
          <mxGeometry x="86" y="416" width="788" height="29" as="geometry" />
        </mxCell>
        <mxCell id="a_cost" value="同侧：割容量 w，偏移 −w，C = 0。     分侧：割容量 2w，偏移 −w，C = w。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F4F8ED;strokeColor=#A4BF8A;strokeWidth=1.5;fontColor=#284531;fontFamily=PingFang SC;fontSize=19;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;shadow=0;glass=0;rotatable=0;" vertex="1" parent="1">
