        </mxCell>
        <mxCell id="b_panel" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#314B62;strokeWidth=1.5;fontColor=#173042;fontFamily=PingFang SC;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;shadow=0;glass=0;rotatable=0;" vertex="1" parent="1">
          <mxGeometry x="52" y="515" width="856" height="275" as="geometry" />
        </mxCell>
        <mxCell id="b_title" value="例 B｜Fₑ = {a, c}：已固定触及所选核心 a 和另一个核心 c" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=0;fontColor=#173042;fontFamily=PingFang SC;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;shadow=0;glass=0;rotatable=0;" vertex="1" parent="1">
          <mxGeometry x="76" y="535" width="808" height="43" as="geometry" />
        </mxCell>
        <mxCell id="b_formula" value="a 已在 Fₑ 中，不再建立“有链在 a”的容量边；只有新增核心 b 才增加复制。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=0;fontColor=#314B62;fontFamily=PingFang SC;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;shadow=0;glass=0;rotatable=0;" vertex="1" parent="1">
          <mxGeometry x="78" y="588" width="804" height="37" as="geometry" />
        </mxCell>
        <mxCell id="b_source" value="源侧：a" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF2F9;strokeColor=#315F84;strokeWidth=1.5;fontColor=#173042;fontFamily=PingFang SC;fontSize=21;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;shadow=0;glass=0;rotatable=0;" vertex="1" parent="1">
          <mxGeometry x="92" y="648" width="166" height="51" as="geometry" />
