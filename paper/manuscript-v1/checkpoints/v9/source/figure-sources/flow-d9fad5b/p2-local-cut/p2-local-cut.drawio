  <diagram id="p2-local-cut" name="P2 two-core local cut">
    <mxGraphModel dx="960" dy="1130" grid="0" guides="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="1130" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="scope" value="所选两个核心：a、b；至多 16 条可移动计算链&#10;Fₑ：同一超边在调整区域外已固定触及的核心集合" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF2F9;strokeColor=#254D71;strokeWidth=1.5;fontColor=#173042;fontFamily=PingFang SC;fontSize=21;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;shadow=0;glass=0;rotatable=0;" vertex="1" parent="1">
          <mxGeometry x="52" y="22" width="856" height="94" as="geometry" />
        </mxCell>
        <mxCell id="a_panel" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#314B62;strokeWidth=1.5;fontColor=#173042;fontFamily=PingFang SC;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;shadow=0;glass=0;rotatable=0;" vertex="1" parent="1">
          <mxGeometry x="52" y="139" width="856" height="358" as="geometry" />
        </mxCell>
        <mxCell id="a_title" value="例 A｜Fₑ = ∅，超边连接两条可移动链 u、v，权重为 w 字节" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=0;fontColor=#173042;fontFamily=PingFang SC;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;shadow=0;glass=0;rotatable=0;" vertex="1" parent="1">
          <mxGeometry x="76" y="157" width="808" height="43" as="geometry" />
        </mxCell>
        <mxCell id="a_formula" value="复制字节数 C = w ×（触及核心数 − 1）；源侧代表核心 a，汇侧代表核心 b。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=0;fontColor=#314B62;fontFamily=PingFang SC;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;shadow=0;glass=0;rotatable=0;" vertex="1" parent="1">
          <mxGeometry x="78" y="205" width="804" height="38" as="geometry" />
        </mxCell>
        <mxCell id="a_pins1" value="u、v" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E7F5F2;strokeColor=#268078;strokeWidth=1.5;fontColor=#173042;fontFamily=PingFang SC;fontSize=21;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;shadow=0;glass=0;rotatable=0;" vertex="1" parent="1">
          <mxGeometry x="92" y="273" width="166" height="51" as="geometry" />
        </mxCell>
