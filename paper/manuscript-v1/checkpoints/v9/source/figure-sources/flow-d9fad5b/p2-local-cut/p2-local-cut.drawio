        <mxCell id="b_aux" value="辅助节点 q_b" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F1EBFA;strokeColor=#795A9D;strokeWidth=1.5;fontColor=#173042;fontFamily=PingFang SC;fontSize=21;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;shadow=0;glass=0;rotatable=0;" vertex="1" parent="1">
          <mxGeometry x="374" y="648" width="203" height="51" as="geometry" />
        </mxCell>
        <mxCell id="b_pins" value="u、v" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E7F5F2;strokeColor=#268078;strokeWidth=1.5;fontColor=#173042;fontFamily=PingFang SC;fontSize=21;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;shadow=0;glass=0;rotatable=0;" vertex="1" parent="1">
          <mxGeometry x="694" y="648" width="166" height="51" as="geometry" />
        </mxCell>
        <mxCell id="b_cost" value="全部在 a：割容量 0，偏移 +w，C = w。   有链在 b：割容量 w，偏移 +w，C = 2w。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F4F8ED;strokeColor=#A4BF8A;strokeWidth=1.5;fontColor=#284531;fontFamily=PingFang SC;fontSize=19;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;shadow=0;glass=0;rotatable=0;" vertex="1" parent="1">
          <mxGeometry x="79" y="733" width="802" height="37" as="geometry" />
        </mxCell>
        <mxCell id="guard_panel" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#314B62;strokeWidth=1.5;fontColor=#173042;fontFamily=PingFang SC;fontSize=20;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;shadow=0;glass=0;rotatable=0;" vertex="1" parent="1">
          <mxGeometry x="52" y="808" width="856" height="285" as="geometry" />
        </mxCell>
        <mxCell id="guard_title" value="局部最小割之后，检查计算工作量（模拟时钟周期）" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=0;fontColor=#173042;fontFamily=PingFang SC;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;shadow=0;glass=0;rotatable=0;" vertex="1" parent="1">
          <mxGeometry x="76" y="828" width="808" height="44" as="geometry" />
        </mxCell>
        <mxCell id="guard_cut" value="求最小割&#10;精确比较当前区域的&#10;原始 COPY 字节数" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F7FBFE;strokeColor=#4E7898;strokeWidth=1.5;fontColor=#173042;fontFamily=PingFang SC;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;shadow=0;glass=0;rotatable=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="895" width="238" height="108" as="geometry" />
        </mxCell>
        <mxCell id="guard_cap" value="逐核、逐类检查&#10;计算流水线（Pipe）工作量&#10;超限：移入链回原核&#10;并重求最小割" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F7FBFE;strokeColor=#4E7898;strokeWidth=1.5;fontColor=#173042;fontFamily=PingFang SC;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;shadow=0;glass=0;rotatable=0;" vertex="1" parent="1">
          <mxGeometry x="363" y="895" width="238" height="108" as="geometry" />
        </mxCell>
        <mxCell id="guard_accept" value="只在工作量满足上限、&#10;局部复制字节数严格减少时&#10;保留新的核心分配" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F7FBFE;strokeColor=#4E7898;strokeWidth=1.5;fontColor=#173042;fontFamily=PingFang SC;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;shadow=0;glass=0;rotatable=0;" vertex="1" parent="1">
          <mxGeometry x="646" y="895" width="238" height="108" as="geometry" />
        </mxCell>
        <mxCell id="guard_bound" value="若有 r 条可移动链，最多求解 r + 1 次；原分配始终可行。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F4F8ED;strokeColor=#A4BF8A;strokeWidth=1.5;fontColor=#284531;fontFamily=PingFang SC;fontSize=19;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;shadow=0;glass=0;rotatable=0;" vertex="1" parent="1">
          <mxGeometry x="91" y="1038" width="778" height="39" as="geometry" />
        </mxCell>
