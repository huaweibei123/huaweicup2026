          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="guard_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#55758B;strokeWidth=2.5;endArrow=block;endFill=1;fontColor=#173042;fontFamily=Arial;fontSize=20;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="guard_cut" target="guard_cap">
