          <mxGeometry x="78" y="200" width="250" height="54" as="geometry" />
        </mxCell>
        <mxCell id="base2" value="把主导计算部分按&#10;独立输出区域分段" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E8F4F5;strokeColor=#26777C;strokeWidth=1.5;fontColor=#173042;fontFamily=PingFang SC;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;shadow=0;glass=0;rotatable=0;" vertex="1" parent="1">
