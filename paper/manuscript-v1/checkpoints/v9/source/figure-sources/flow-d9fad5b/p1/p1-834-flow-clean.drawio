        <mxCell id="base_note" value="¹ 按结构尝试；重复不评分；可选构造或评分失败回退；E1 最多调用 6 次。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#40566A;fontFamily=PingFang SC;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;shadow=0;glass=0;rotatable=0;" vertex="1" parent="1">
