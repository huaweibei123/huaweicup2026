<mxfile host="Electron" agent="drawio" version="24.7.5">
  <diagram id="fig5-1" name="fig-5-1">
    <mxGraphModel dx="800" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="728" pageHeight="1070" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="图 5-1｜P2 张量通信优化技术路线（结构初解 → gap → hypergap → 有限候选评分）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="20" y="4" width="688" height="20" as="geometry" /></mxCell>
        <mxCell id="mainLane" value="" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#F4F9FD;strokeColor=#2E86AB;strokeWidth=1.5;fontSize=12;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="16" y="28" width="508" height="1006" as="geometry" /></mxCell>
        <mxCell id="mainLaneTitle" value="主线｜候选构造与完整评分（算法 5-1；c66559a6 adaptive_hypergap_guarded.py）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#1F5FA8;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="28" y="32" width="484" height="18" as="geometry" /></mxCell>
        <mxCell id="in" value="输入：原始图 G · 核数 k · 冻结配置 θ（P2）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#2E86AB;fontSize=11;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="110" y="56" width="320" height="34" as="geometry" /></mxCell>
        <mxCell id="route" value="结构初解（adaptive_budget.build → adaptive_semantic.build；allow_component_split=False）&#10;① resource_word：词资源识别成功（:43–52 立即返回）&#10;② tree_paired_leaves：归约树守卫成功（:53–60 立即返回）&#10;③ 一般路由（:62–68）：分量数≥k → component_route/adaptive_frontier（仅共享外部输入超容量时尝试波次：active_core_wave 式(5-7) 最少核，不支持退 shared_input_wave，波次不支持回 component_envelope）；分量数低于 k → DAG 最早完成&#10;④ 条件向量修复（:69–84）：vector_lanes 识别且大张量跨核 → vector_arrival" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5DA7CC;fontSize=10;fontFamily=Microsoft YaHei;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="102" width="440" height="176" as="geometry" /></mxCell>
        <mxCell id="p0" value="各路由按序汇合 → 初始方案 Π₀（完整候选）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#2E86AB;fontSize=11;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="56" y="286" width="408" height="34" as="geometry" /></mxCell>
        <mxCell id="guard" value="分叉汇合守卫&#10;与物理依赖检查通过？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B7791F;fontSize=10.5;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="186" y="332" width="148" height="54" as="geometry" /></mxCell>
        <mxCell id="gap" value="链收缩 + 间隙日历排程 → Πgap（gap_candidate / gap_calendar）&#10;式(5-8) 逆拓扑 r_j · 空隙放置 · 汇合时至多 k² 核心对比较" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5DA7CC;fontSize=10.5;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="56" y="398" width="408" height="54" as="geometry" /></mxCell>
        <mxCell id="hyper" value="一遍两核区域超图改进（式 5-9；hypergraph_cost / binary_hypercut）&#10;区域 ≤16 链 · Dinic 最小割 + 逐次锚定 · 流水线负载上限锚回&#10;静态基础 COPY 字节目标（非完整执行时间）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5DA7CC;fontSize=10.5;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="56" y="464" width="408" height="62" as="geometry" /></mxCell>
        <mxCell id="dec" value="基础 COPY 字节&#10;严格下降？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B7791F;fontSize=10.5;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="186" y="538" width="148" height="52" as="geometry" /></mxCell>
        <mxCell id="retime" value="固定分核重排 → Πhypergap（gap_retime；只改核内优先级）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5DA7CC;fontSize=10.5;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="56" y="602" width="408" height="38" as="geometry" /></mxCell>
        <mxCell id="dedup" value="完整计划去重（式 5-10）：C = {Π₀, Πgap, Πhypergap}distinct，|C| ≤ 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#2E86AB;fontSize=11;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="56" y="652" width="408" height="36" as="geometry" /></mxCell>
        <mxCell id="dec2" value="去重后&#10;|C| = 1？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B7791F;fontSize=10.5;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="186" y="700" width="148" height="50" as="geometry" /></mxCell>
        <mxCell id="score" value="原生 E2 完整评分，每方案 ≤ 1 次、总计 ≤ 3 次（adaptive_guarded）&#10;在线费用计入求解墙钟" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5DA7CC;fontSize=10.5;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="56" y="762" width="408" height="48" as="geometry" /></mxCell>
        <mxCell id="select" value="按 (Makespan, 额外 DDR 字节) 择优；平局保留先前计划&#10;候选集合内比较性质，非全局最优性证明" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5DA7CC;fontSize=10.5;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="56" y="834" width="408" height="44" as="geometry" /></mxCell>
        <mxCell id="plan" value="官方方案文件（严格仅两字段）：node_to_subgraph ｜ core_schedules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B7791F;fontSize=11;fontStyle=1;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="56" y="890" width="408" height="36" as="geometry" /></mxCell>
        <mxCell id="e0" value="E0 独立复评（实验阶段，未修改官方评估器；与在线 E2 分开表示）" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FDF8F2;strokeColor=#D35400;fontSize=10.5;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="56" y="938" width="408" height="34" as="geometry" /></mxCell>
        <mxCell id="note53" value="去向一览：gap 不支持 → 仅 Π₀；hyper/retime 不支持或字节不降 → 保留已有候选；构造意外异常、字节证据非法或评分异常 → 记录 unknown 并退回 Π₀（入口 :27–100）；|C|=1 直接保留不评分。S3：字节下降只决定是否追加 Πhypergap。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#B7791F;fontSize=10;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="56" y="980" width="408" height="44" as="geometry" /></mxCell>
        <mxCell id="sideLane" value="" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=#FBFCFC;strokeColor=#7F8C8D;strokeWidth=1.2;fontSize=12;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="540" y="28" width="184" height="1006" as="geometry" /></mxCell>
        <mxCell id="sideTitle" value="辅助｜诊断与研究模块（不入主线构造与评分）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#5D6D7E;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="548" y="32" width="168" height="34" as="geometry" /></mxCell>
        <mxCell id="cap" value="容量闭区间条件与必要下界（5.5；命题 2、式 5-14～5-17；S2：OPTIMALITY_BOUNDS / FIFO_BOUND）&#10;仅诊断/解释，不进入候选构造与评分" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F4F6F7;strokeColor=#7F8C8D;fontSize=10;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="550" y="332" width="164" height="104" as="geometry" /></mxCell>
        <mxCell id="stat" value="静态估计仅用于构造与优先序：式(5-7)/(5-9)、日历时钟&#10;不是正式成绩，也不作一般 Makespan 下界" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F4F6F7;strokeColor=#7F8C8D;fontSize=10;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="550" y="464" width="164" height="88" as="geometry" /></mxCell>
        <mxCell id="res" value="未接入本入口的容量保护 / 就绪匹配等研究&#10;不参与候选构造与评分" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F4F6F7;strokeColor=#7F8C8D;fontSize=10;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="550" y="652" width="164" height="76" as="geometry" /></mxCell>
