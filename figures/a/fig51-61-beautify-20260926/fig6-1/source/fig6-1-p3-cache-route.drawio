<mxfile host="Electron" agent="drawio" version="24.7.5">
  <diagram id="fig6-1" name="fig-6-1">
    <mxGraphModel dx="800" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="728" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="图 6-1｜P3 结构构造与缓存评价路线（基准 → 增量候选 → 下界剪枝 → 官方评价 → 严格接受 → 同计划无 L2 对照）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="20" y="4" width="688" height="20" as="geometry" /></mxCell>
        <mxCell id="mainLane" value="" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#F4F9FD;strokeColor=#2E86AB;strokeWidth=1.5;fontSize=12;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="16" y="28" width="508" height="688" as="geometry" /></mxCell>
        <mxCell id="mainLaneTitle" value="主线｜结构构造与官方评价（forest_solve 入口；311322b）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#1F5FA8;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="28" y="32" width="484" height="18" as="geometry" /></mxCell>
        <mxCell id="in" value="输入：原始图 G · 核数 K · 固定配置 θ（P3 共享只读 Cache 场景）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#2E86AB;fontSize=11;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="96" y="56" width="348" height="34" as="geometry" /></mxCell>
        <mxCell id="idx" value="结构索引（construct）：计算依赖、张量生产者/消费者&#10;流水线类型、计算时长、张量字节" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5DA7CC;fontSize=10.5;fontFamily=Microsoft YaHei;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="56" y="102" width="408" height="48" as="geometry" /></mxCell>
        <mxCell id="baseroute" value="基础结构路由与基准（construct 路由表①，6.3.1）：窄条件阶段迁移 → 一般阶段 → 注意力/前馈 → 一般 DAG/通用；仅结构守卫拒绝时依序尝试下一路线&#10;构造基准方案并评价 → 取得当前合法方案与已用 calls（计入总预算 ≤3）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5DA7CC;fontSize=10;fontFamily=Microsoft YaHei;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="56" y="162" width="408" height="62" as="geometry" /></mxCell>
        <mxCell id="incloop" value="后续增量候选：按序、守卫及剩余预算尝试（实际调用链 expanded → calendar → pipeline → witness → forest）&#10;② attention_gap：仅注意力路线且多核（attention_rows）&#10;③ shared_pipeline：仅多核且构造守卫通过（pipeline_solve / calendar_solve）&#10;④ attention_witness：仅放置代理严格优于就绪重排代理且 calls&lt;3（witness_solve）&#10;⑤ forest_memory_order：归约森林守卫通过且 calls&lt;3（forest_solve）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5DA7CC;fontSize=10;fontFamily=Microsoft YaHei;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="56" y="236" width="408" height="96" as="geometry" /></mxCell>
        <mxCell id="dedup" value="规范化提交字节去重：重复方案跳过评分，继续剩余流程" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5DA7CC;fontSize=10.5;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="56" y="344" width="408" height="30" as="geometry" /></mxCell>
        <mxCell id="prune" value="条件下界剪枝（pipe_bound.analyze :78–112 适用检查）&#10;适用：每子图恰一个原始非 COPY 计算节点 · 仅 PIPE_M/PIPE_V · 非负整数 cycles · 固定非负整数跨核 delay · COPY 收缩不引入未证依赖（循环等不支持则不用界，照常评价）&#10;L(P)（式 6-10）≥ 当前合法方案 Makespan → bound_pruned，跳过评分继续" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5DA7CC;fontSize=10;fontFamily=Microsoft YaHei;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="56" y="386" width="408" height="76" as="geometry" /></mxCell>
        <mxCell id="e0" value="仅评未被剪枝的候选：官方 P3 评价（未修改 E0；总上限 3 次在线，含基准）&#10;求解器不可修改官方 Cache 替换规则、容量与带宽" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF8F2;strokeColor=#D35400;fontSize=10.5;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="56" y="474" width="408" height="52" as="geometry" /></mxCell>
        <mxCell id="acc" value="严格改进接受：执行合法且 M₃ 严格更小 → 更新当前方案；&#10;合法性拒绝或相同成绩 → 保留已有合法方案（评价异常向外报告，不静默吞掉）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5DA7CC;fontSize=10;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="56" y="538" width="408" height="52" as="geometry" /></mxCell>
        <mxCell id="plan" value="最终合法方案及指标（两字段方案 node_to_subgraph ｜ core_schedules；评价账本/选择原因/墙钟）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B7791F;fontSize=10.5;fontStyle=1;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="56" y="602" width="408" height="38" as="geometry" /></mxCell>
        <mxCell id="note53" value="E0 预算为每图/核数 3 次在线调用（含基准）；候选较少不等于总墙钟等于某内部动态规划时长；程序缺陷、保存失败与未归类评价错误向外报告，不伪装成功回退" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#B7791F;fontSize=10;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="56" y="652" width="408" height="44" as="geometry" /></mxCell>
        <mxCell id="sideLane" value="" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=#FBFCFC;strokeColor=#7F8C8D;strokeWidth=1.2;fontSize=12;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="540" y="28" width="184" height="520" as="geometry" /></mxCell>
        <mxCell id="sideTitle" value="旁注｜研究拓展（不执行）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#5D6D7E;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="548" y="32" width="168" height="20" as="geometry" /></mxCell>
        <mxCell id="ext" value="未纳入完整批次的扩展（研究拓展，本入口不执行）：&#10;容量切分与共享输入流水驻留 DP（6.4）&#10;部分预加载与部分分桶（6.4.4）&#10;单尾切分与首波阶梯（6.5.2）&#10;四系数响应压缩（6.5.3）" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F4F6F7;strokeColor=#7F8C8D;fontSize=10;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="550" y="60" width="164" height="140" as="geometry" /></mxCell>
        <mxCell id="branchLane" value="" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#FDF8F2;strokeColor=#D35400;strokeWidth=1.5;fontSize=12;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="540" y="560" width="184" height="272" as="geometry" /></mxCell>
        <mxCell id="branchTitle" value="同计划无 L2 对照分支（仅报告指标）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11.5;fontStyle=1;fontColor=#D35400;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="548" y="564" width="168" height="32" as="geometry" /></mxCell>
        <mxCell id="nol2" value="同计划无 L2 评价：同一方案字节在无 L2 场景评 M₂(G,P)（式 6-4；仅 Cache 场景变化；计划身份经配对审计绑定；476 份复用 / 24 份另评为已发布批次口径，见初稿 6.6.1）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D35400;fontSize=10;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="548" y="600" width="168" height="106" as="geometry" /></mxCell>
        <mxCell id="cg" value="CacheGain 出口：C = M₂ / M₃&#10;（M₂=同计划无 L2，M₃=只读 Cache）&#10;C&gt;1 改善、C&lt;1 退化；仅报告指标，候选接受仍只比较 M₃，不与独立优化的 P2 主算法比较混同" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B7791F;fontSize=10;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="548" y="714" width="168" height="106" as="geometry" /></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#34495E;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="in" target="idx"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#34495E;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="idx" target="baseroute"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#34495E;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="baseroute" target="incloop"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="每个可行候选" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#34495E;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=10;fontFamily=Microsoft YaHei;verticalAlign=top;" edge="1" parent="1" source="incloop" target="dedup"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#34495E;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="dedup" target="prune"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#34495E;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="prune" target="e0"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#34495E;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="e0" target="acc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B7791F;strokeWidth=1.6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="acc" target="plan"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D35400;strokeWidth=1.3;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="plan" target="nol2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="532" y="621" /><mxPoint x="532" y="653" /></Array></mxGeometry></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D35400;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="nol2" target="cg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s1" value="研究拓展（不执行）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#95A5A6;strokeWidth=1;dashed=1;endArrow=open;exitX=0;exitY=0.5;entryX=1;entryY=0.5;fontSize=10;fontFamily=Microsoft YaHei;align=left;spacingLeft=3;" edge="1" parent="1" source="ext" target="baseroute"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="532" y="130" /><mxPoint x="532" y="211" /></Array></mxGeometry></mxCell>
