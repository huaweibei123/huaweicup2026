* text=auto
.gitattributes text eol=lf
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.tex text eol=lf
*.cls text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.tsv text eol=lf
*.cpp text eol=lf
*.rs text eol=lf
*.lock text eol=lf
*.gz binary
*.png binary
*.jpg binary
*.pdf binary
# Preserve the classroom archive byte-for-byte, including upstream whitespace.
paper/template-2025/** -text -whitespace !eol
# Keep the vendored Skill identical to its pinned upstream commit.
.agents/skills/system-atlas/** -text -whitespace !eol

# Preserve the figures4papers Skill and upstream license byte-for-byte.
.agents/skills/scientific-figure-making/** -text -whitespace !eol

# Preserve official A-problem source bytes on every checkout (including Windows).
data/raw/a/** -text -whitespace !eol

# Preserve imported discussion bytes and their manifest hashes on Windows.
AI[[:space:]]chats/** -text -whitespace !eol
