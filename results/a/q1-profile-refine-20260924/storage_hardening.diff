+def atomic_plan(path, data):
+    """A killed/failed promotion must not truncate the previously confirmed plan."""
+    pending = path.with_name(path.name + '.pending')
+    with pending.open('wb') as stream:
+        stream.write(data)
+        stream.flush()
+        os.fsync(stream.fileno())
+    os.replace(pending, path)
